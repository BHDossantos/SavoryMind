{
  "name": "savorymind-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.20",
    "expo-auth-session": "~58.0.17",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "i18next": "^25.10.10",
    "posthog-react-native": "^4.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^15.7.4",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "10.12.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.24.0",
    "@testing-library/react-native": "^14.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~58.0.24",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^expo-localization$": "<rootDir>/__mocks__/expo-localization.js",
      "^expo-clipboard$": "<rootDir>/__mocks__/expo-clipboard.js",
      "^expo-notifications$": "<rootDir>/__mocks__/expo-notifications.js",
      "^expo-device$": "<rootDir>/__mocks__/expo-device.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ]
  }
}
